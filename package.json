{
  "name": "disenador-muebles-dto",
  "private": true,
  "version": "1.0.0",
  "description": "Diseñador 3D de muebles a medida para vendedores de De Todito Outlet (Supabase)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_BACKEND=local vite",
    "build": "node scripts/sync-productos.mjs --sin-fallar && tsc -p tsconfig.json && vite build && node scripts/construir-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sync:productos": "node scripts/sync-productos.mjs",
    "build:api": "node scripts/construir-api.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.117.3",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
